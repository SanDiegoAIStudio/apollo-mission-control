# LLM Provider
# Supports: anthropic, openai, local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LOCAL_MODEL_URL=http://localhost:11434/v1

# Model selection per agent tier
MODEL_FLIGHT_DIRECTOR=claude-sonnet-4-5-20250929
MODEL_SEAT_AGENT=claude-haiku-4-5-20251001

# kOS Telnet Connection
KOS_HOST=127.0.0.1
KOS_PORT=5410

# Mission Control Settings
TICK_INTERVAL_SEC=2.0
LOG_LEVEL=INFO
MISSION_LOG_DIR=./mission_logs
